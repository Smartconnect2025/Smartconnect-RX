+  /**
+   * Convert a Supabase/PostgREST write error into a human-readable
+   * message that explains exactly what went wrong (e.g. NPI already
+   * registered to another provider) instead of a generic "save
+   * failed". `attemptedData` is the form payload so we can echo the
+   * conflicting value when helpful.
+   */
+  private describeProviderWriteError(
+    error: { code?: string; message?: string; details?: string } | null,
+    attemptedData?: { npiNumber?: string | null } | Record<string, unknown>,
+  ): string {
+    const code = error?.code;
+    const blob = `${error?.message || ""} ${error?.details || ""}`;
+
+    // 23505 = unique_violation. PostgREST also surfaces this through the
+    // HTTP 409 status. The constraint name is included in the error
+    // details, so we use that to identify the exact column at fault.
+    if (
+      code === "23505" ||
+      /duplicate key|already exists|unique constraint/i.test(blob)
+    ) {
+      if (/npi_number|providers_npi_number_unique/i.test(blob)) {
+        const tried =
+          attemptedData &&
+          typeof (attemptedData as { npiNumber?: string | null }).npiNumber ===
+            "string"
+            ? ((attemptedData as { npiNumber?: string | null })
+                .npiNumber as string)
+            : "";
+        return tried
+          ? `NPI ${tried} is already registered to another provider. Please enter a different NPI.`
+          : "That NPI is already registered to another provider. Please enter a different NPI.";
+      }
+      if (/user_id|providers_user_id_unique/i.test(blob)) {
+        return "A provider profile already exists for this account. Please refresh the page and try again.";
+      }
+      return "This information conflicts with an existing record. Please review your entries.";
+    }
+
+    // RLS / permission issues
+    if (code === "42501" || /row-level security|permission denied/i.test(blob)) {
+      return "You don't have permission to update this profile. Please sign out and sign in again.";
+    }
+
+    const fallback = error?.message || error?.details || "Unknown database error";
+    return `Failed to save profile: ${fallback}`;
   }
 
