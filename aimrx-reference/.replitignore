# Files Replit's Git sync should NEVER push to GitHub.
# This is belt-and-suspenders on top of .gitignore.

# Replit AI chat artifacts — may contain pasted secrets from the Replit Secrets panel.
attached_assets/
**/Pasted-Skip-to-content-*
**/Pasted-*Library-Search-Other-Documents-Secrets-*

# Environment / secrets files
.env
.env.local
.env.production
.env.*.local

# Local logs
*.log
/tmp/
.local/
